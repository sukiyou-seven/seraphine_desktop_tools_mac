{
  "name": "seraphim-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Seraphim cross-platform server management client",
  "author": "Seraphim",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "prepare:server": "node scripts/prepare-server.js",
    "pack:mac": "npm run prepare:server && electron-builder --mac zip --arm64",
    "pack:win": "npm run prepare:server && electron-builder --win zip --x64",
    "pack:linux": "npm run prepare:server && electron-builder --linux tar.gz --x64",
    "pack:all": "npm run pack:mac && npm run pack:win && npm run pack:linux"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.seraphim.desktop",
    "productName": "Seraphim",
    "asar": true,
    "directories": {
      "output": "../build/electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/icon.png",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/sera-linux-amd64",
        "to": "server/sera-linux-amd64"
      },
      {
        "from": "assets/sera-linux-arm64",
        "to": "server/sera-linux-arm64"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "../Resources/AppIcon.icns",
      "identity": null,
      "target": [
        "zip"
      ],
      "artifactName": "Seraphim-Electron-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "zip"
      ],
      "artifactName": "Seraphim-Electron-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "category": "Development",
      "icon": "assets/icon.png",
      "target": [
        "tar.gz"
      ],
      "artifactName": "Seraphim-Electron-${version}-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "ssh2": "^1.17.0"
  }
}
